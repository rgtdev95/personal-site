# Copy to .env.prod / .env.test on the VPS. Never commit real values.
APP_ENV=production                 # production | test
SITE_URL=https://ronsystemsai.com  # https://test.ronsystemsai.com for test
SECRET_KEY=change-me               # python -c "import secrets; print(secrets.token_hex(32))"

CONTACT_EMAIL=hello@ronsystemsai.com
CALENDLY_URL=                      # e.g. https://calendly.com/ronsystemsai/discovery ; empty = contact form only

SOCIAL_LINKEDIN=http://127.0.0.1:8000/
SOCIAL_YOUTUBE=http://127.0.0.1:8000/
SOCIAL_FACEBOOK=http://127.0.0.1:8000/
SOCIAL_GITHUB=http://127.0.0.1:8000/

# Proton Mail SMTP submission (empty SMTP_HOST = messages are logged, not sent)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=hello@ronsystemsai.com
SMTP_PASSWORD=                     # Proton SMTP token, not your account password
MAIL_FROM=hello@ronsystemsai.com
MAIL_TO=hello@ronsystemsai.com

# Umami (prod only)
UMAMI_SCRIPT_URL=https://stats.ronsystemsai.com/script.js
UMAMI_WEBSITE_ID=
